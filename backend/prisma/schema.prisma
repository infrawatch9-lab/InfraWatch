generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int            @id @default(autoincrement())
  name                   String
  email                  String         @unique
  password               String
  role                   Role           @default(USER)
  isTemporaryPassword    Boolean        @default(false)
  temporaryPasswordExpiry DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  alerts                 Alert[]
  createdAlertRules      AlertRule[]    @relation("CreatedByUser")
  notifications          Notification[]
  teams                  TeamMember[]
}

model Team {
  id        Int          @id @default(autoincrement())
  name      String
  createdAt DateTime     @default(now())
  services  Service[]
  members   TeamMember[]
}

model TeamMember {
  id     Int      @id @default(autoincrement())
  userId Int
  teamId Int
  role   TeamRole
  Team   Team     @relation(fields: [teamId], references: [id])
  User   User     @relation(fields: [userId], references: [id])
}

model Service {
  id        Int                @id @default(autoincrement())
  name      String
  type      ServiceType
  endpoint  String
  protocol  String
  status    ServiceStatus      @default(PENDING)
  teamId    Int
  createdAt DateTime           @default(now())
  alerts    Alert[]
  rules     AlertRule[]        @relation("ServiceToAlertRules")
  configs   MonitoringConfig[]
  slas      SLA[]
  Team      Team               @relation(fields: [teamId], references: [id])
  metrics   Metric[]
  logs      SystemLog[]
}

model Metric {
  id        Int           @id @default(autoincrement())
  serviceId Int
  timestamp DateTime      @default(now())
  cpu       Float?
  memory    Float?
  latency   Float?
  status    ServiceStatus
  errorMsg  String?
  Service   Service       @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@index([serviceId, timestamp])
  @@map("metrics")
}

model AlertRule {
  id            Int        @id @default(autoincrement())
  serviceId     Int
  field         String
  condition     String
  severity      AlertLevel
  active        Boolean    @default(true)
  createdBy     Int
  createdAt     DateTime   @default(now())
  alerts        Alert[]
  createdByUser User       @relation("CreatedByUser", fields: [createdBy], references: [id])
  Service       Service    @relation("ServiceToAlertRules", fields: [serviceId], references: [id])
}

model Alert {
  id            Int            @id @default(autoincrement())
  serviceId     Int
  ruleId        Int
  triggeredAt   DateTime       @default(now())
  message       String
  resolved      Boolean        @default(false)
  userId        Int?
  AlertRule     AlertRule      @relation(fields: [ruleId], references: [id])
  Service       Service        @relation(fields: [serviceId], references: [id])
  User          User?          @relation(fields: [userId], references: [id])
  notifications Notification[]
}

model Notification {
  id      Int                 @id @default(autoincrement())
  userId  Int
  alertId Int?
  message String
  type    NotificationType
  channel NotificationChannel
  sentAt  DateTime            @default(now())
  Alert   Alert?              @relation(fields: [alertId], references: [id])
  User    User                @relation(fields: [userId], references: [id])
}

model SLA {
  id          Int       @id @default(autoincrement())
  serviceId   Int
  periodStart DateTime
  periodEnd   DateTime
  uptimePct   Float
  downtime    Int
  status      SLAStatus
  Service     Service   @relation(fields: [serviceId], references: [id])
}

model MonitoringConfig {
  id         Int     @id @default(autoincrement())
  serviceId  Int
  frequency  Int
  timeout    Int
  webhookUrl String?
  Service    Service @relation(fields: [serviceId], references: [id])
}

model SystemLog {
  id         Int        @id @default(autoincrement())
  timestamp  DateTime   @default(now())
  type       LogType
  message    String
  serviceId  Int?

  Service    Service?   @relation(fields: [serviceId], references: [id]) // Serviço relacionado (opcional)
  
  @@index([timestamp]) // Índice temporal para TimescaleDB
  @@index([serviceId, timestamp]) // Índice composto para consultas por serviço
  
  @@map("system_logs")
}

// Agente 
model Agent {
  id           String         @id @default(cuid())
  host         String         @unique
  createdAt    DateTime       @default(now())
  metrics      AgentMetric[]
}

// Tipos de métricas que pegamos do agent
model AgentMetric {
  id         Int        @id @default(autoincrement())
  timestamp  DateTime   @default(now())
  cpu        Float
  memory     Float
  disk       Float
  uptime     Int
  bytesSent  BigInt
  bytesRecv  BigInt
  latency    Json
  logs       Json?
  alerts     Json?

  agentId    String
  agent      Agent      @relation(fields: [agentId], references: [id])

  @@index([timestamp])
  @@index([agentId, timestamp])
  @@map("agent_metrics")
}


// Tipo de utilizador no sistema
enum Role {
  ADMIN
  USER
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum ServiceType {
  SERVER
  NETWORK
  WEBSITE
  DATABASE
  API
  CUSTOM
}

enum ServiceStatus {
  UP
  DOWN
  DEGRADED
  PENDING
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

enum NotificationType {
  ALERT
  INFO
  SYSTEM
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
}

enum SLAStatus {
  OK
  VIOLATED
  UNKNOWN
}

enum LogType {
  INFO
  ERROR
  WARNING
  EVENT
}

enum MetricType {
  CPU
  MEMORY
  LATENCY
  STATUS
}

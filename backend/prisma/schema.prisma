generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       Int                       @id @default(autoincrement())
  name                     String
  email                    String                    @unique
  password                 String
  role                     Role                      @default(USER)
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt
  isTemporaryPassword      Boolean                   @default(false)
  status                   Status                    @default(ACTIVE)
  temporaryPasswordExpiry  DateTime?
  number                   String?
  alerts                   Alert[]
  createdAlertRules        AlertRule[]               @relation("CreatedByUser")
  notifications            Notification[]
  serviceUserNotifications ServiceUserNotification[]
  teams                    TeamMember[]
  agents                   Agent[]
}

model Team {
  id        Int          @id @default(autoincrement())
  name      String
  createdAt DateTime     @default(now())
  services  Service[]
  members   TeamMember[]
}

model TeamMember {
  id     Int      @id @default(autoincrement())
  userId Int
  teamId Int
  role   TeamRole
  Team   Team     @relation(fields: [teamId], references: [id])
  User   User     @relation(fields: [userId], references: [id])
}

model Service {
  id            Int                       @id @default(autoincrement())
  checkcleId    String?   
  name          String
  type          ServiceType
  status        ServiceStatus             @default(ACTIVE)
  teamId        Int
  createdAt     DateTime                  @default(now())
  description   String                    @default("Sem descrição")
  targetSLA     Float?                    @default(99.9) // SLA alvo por serviço
  alerts        Alert[]
  rules         AlertRule[]               @relation("ServiceToAlertRules")
  configs       MonitoringConfig?
  slas          SLA[]
  Team          Team                      @relation(fields: [teamId], references: [id])
  usersToNotify ServiceUserNotification[]
  metrics       Metric[]
  logs          SystemLog[]
}

model Metric {
  id        Int           @id @default(autoincrement())
  serviceId Int
  timestamp DateTime      @default(now())
  cpu       Float?
  memory    Float?
  latency   Float?
  status    ServiceStatus
  errorMsg  String?
  Service   Service       @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@map("metrics")
}

model AlertRule {
  id            Int        @id @default(autoincrement())
  serviceId     Int
  field         String
  condition     String
  severity      AlertLevel
  active        Boolean    @default(true)
  createdBy     Int
  createdAt     DateTime   @default(now())
  alerts        Alert[]
  createdByUser User       @relation("CreatedByUser", fields: [createdBy], references: [id], onDelete: Cascade)
  Service       Service    @relation("ServiceToAlertRules", fields: [serviceId], references: [id], onDelete: Cascade)
}

model Alert {
  id            Int            @id @default(autoincrement())
  serviceId     Int
  ruleId        Int
  triggeredAt   DateTime       @default(now())
  message       String
  resolved      Boolean        @default(false)
  userId        Int?
  AlertRule     AlertRule      @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  Service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  User          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications Notification[]
}

model ServiceUserNotification {
  id        Int     @id @default(autoincrement())
  serviceId Int
  userId    Int
  Service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
}

model Notification {
  id        Int                 @id @default(autoincrement())
  userId    Int
  alertId   Int?
  title     String              @default("Notificação")
  content   String              
  message   String              @default("") // Manter message para compatibilidade
  type      NotificationType
  channel   NotificationChannel
  timestamp DateTime            @default(now())
  isRead    Boolean             @default(false)
  readAt    DateTime?
  Alert     Alert?              @relation(fields: [alertId], references: [id])
  User      User                @relation(fields: [userId], references: [id])
}

model SLA {
  id          Int       @id @default(autoincrement())
  serviceId   Int
  periodStart DateTime
  periodEnd   DateTime
  uptimePct   Float
  downtime    Int
  status      SLAStatus
  Service     Service   @relation(fields: [serviceId], references: [id])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  type      LogType
  message   String
  message_received  Json?
  serviceId Int?
  Service   Service? @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@index([serviceId, timestamp])
  @@map("system_logs")
}

model MonitoringConfig {
  id            Int            @id @default(autoincrement())
  serviceId     Int            @unique
  timeout       Int
  webhookUrl    String?
  interval      Int
  HttpConfig    HttpConfig?
  Service       Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  PingConfig    PingConfig?
  SnmpConfig    SnmpConfig?
  WebhookConfig WebhookConfig?
}

model PingConfig {
  id           Int              @id @default(autoincrement())
  monitoringId Int              @unique
  ipAddress    String
  packetSize   Int?
  ttl          Int?
  responseTime Int?
  Monitoring   MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

model SnmpConfig {
  id                     Int              @id @default(autoincrement())
  monitoringId           Int              @unique
  host                   String
  version                SnmpVersion
  community              String?
  username               String?
  authProtocol           String?
  authPassword           String?
  privProtocol           String?
  privPassword           String?
  oid                    String
  retries                Int?
  delay                  Int?
  alertAfterFailures     Int?
  minAlertInterval       Int?
  expectedResponseTimeMs Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  Monitoring             MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

model HttpConfig {
  id                      Int              @id @default(autoincrement())
  serviceId               Int              @unique
  monitoringId            Int              @unique
  endpoint                String
  method                  String           @default("GET")
  headers                 Json?
  body                    Json?
  authType                String?
  authValue               String?
  validateSSL             Boolean?         @default(true)
  followRedirects         Boolean?         @default(true)
  expectedStatus          Int?
  expectedBodyIncludes    String?
  expectedResponseTimeMs  Int?
  expectedHeadersIncludes Json?
  responseTime           Int?
  retries                 Int?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  Monitoring              MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

model WebhookConfig {
  id           Int              @id @default(autoincrement())
  monitoringId Int              @unique
  serviceId    Int              @unique
  endpoint     String
  method       String
  secret       String?
  headers      Json?
  provedor     String
  Monitoring   MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

model NotificationsConfig {
  id          Int           @id @default(autoincrement())
  slackConfig SlackConfig[]
  emailConfig EmailConfig[]
}

model SlackConfig {
  id                   Int                 @id @default(autoincrement())
  configsId            Int
  webhookUrl           String?
  channel              String?
  notificationsConfig  NotificationsConfig @relation(fields: [configsId], references: [id], onDelete: Cascade)
}

model EmailConfig {
  id                   Int                 @id @default(autoincrement())
  configsId            Int
  gmailAppPassword     String?
  gmailUser            String?
  notificationsConfig  NotificationsConfig @relation(fields: [configsId], references: [id], onDelete: Cascade)
}

model CheckcleToken {
  id        Int      @id @default(autoincrement())
  token     String
  expiry    DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OTP {
  id        Int      @id @default(autoincrement())
  email     String
  otp       String
  createdAt DateTime @default(now())
  expiresAt DateTime
}


enum SnmpVersion {
  v1
  v2c
  v3
}

enum Role {
  ADMIN
  USER
  AGENT
  VIEWER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum ServiceType {
  SERVER
  NETWORK
  WEBSITE
  DATABASE
  API
  CUSTOM
  SNMP
  PING
  WEBHOOK
  HTTP
}

enum ServiceStatus {
  UP
  DOWN
  DEGRADED
  PENDING
  PAUSED
  ACTIVE
  INACTIVE
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
  WARNING
}

enum NotificationType {
  EMAIL
  PUSH
  SMS
  SLACK
  TELEGRAM
}

enum NotificationChannel {
  EMAIL
  PUSH
  SMS
  SLACK
  TELEGRAM
  WEBHOOK
}

enum SLAStatus {
  OK
  VIOLATED
  UNKNOWN
}

enum LogType {
  INFO
  ERROR
  WARNING
  EVENT
}

enum MetricType {
  CPU
  MEMORY
  LATENCY
  STATUS
}

enum MonitoringMode {
  cron
  agent
  both
}

model Agent {
  id        String       @id @default(uuid())
  hostname  String
  ip        String
  os        String
  arch      String
  version   String       @default("1.0.0")
  token     String       @unique
  status    AgentStatus  @default(PENDING)
  userId    Int
  lastSeen  DateTime?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  
  User      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  metrics   AgentMetrics[]
  
  @@index([userId])
  @@index([hostname])
  @@index([status])
}

model AgentMetrics {
  id                   Int      @id @default(autoincrement())
  agentId              String
  hostname             String
  timestamp            DateTime
  cpuUsage             Float
  cpuCores             Int
  load1                Float
  load5                Float
  load15               Float
  memoryTotal          BigInt
  memoryUsed           BigInt
  memoryFree           BigInt
  memoryAvailable      BigInt
  memoryUsagePercent   Float
  diskData             String   // JSON array of disk info
  networkData          String   // JSON array of network info
  processesTotal       Int
  processesRunning     Int
  processesSleeping    Int
  processesZombie      Int
  uptime               BigInt
  createdAt            DateTime @default(now())
  
  Agent                Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  
  @@index([agentId])
  @@index([timestamp])
  @@index([hostname])
}

enum AgentStatus {
  PENDING
  ACTIVE
  INACTIVE
  ERROR
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      Int            @id @default(autoincrement())
  name                    String
  email                   String         @unique
  password                String
  role                    Role           @default(USER)
  status                  Status         @default(ACTIVE)
  isTemporaryPassword     Boolean        @default(false)
  temporaryPasswordExpiry DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt
  alerts                  Alert[]
  createdAlertRules       AlertRule[]    @relation("CreatedByUser")
  notifications           Notification[]
  teams                   TeamMember[]
  serviceUserNotifications ServiceUserNotification[]
}

model Team {
  id        Int          @id @default(autoincrement())
  name      String
  createdAt DateTime     @default(now())
  services  Service[]
  members   TeamMember[]
}

model TeamMember {
  id     Int      @id @default(autoincrement())
  userId Int
  teamId Int
  role   TeamRole
  Team   Team     @relation(fields: [teamId], references: [id])
  User   User     @relation(fields: [userId], references: [id])
}

model Service {
  id          Int                @id @default(autoincrement())
  name        String
  description String             @default("Sem descrição")
  type        ServiceType
  status      ServiceStatus      @default(PENDING)
  teamId      Int
  createdAt   DateTime           @default(now())
  alerts      Alert[]
  rules       AlertRule[]        @relation("ServiceToAlertRules")
  configs     MonitoringConfig[] 
  slas        SLA[]
  usersToNotify ServiceUserNotification[]
  metrics     Metric[]
  logs        SystemLog[]
  Team        Team               @relation(fields: [teamId], references: [id])
}

model Metric {
  id        Int           @id @default(autoincrement())
  serviceId Int
  timestamp DateTime      @default(now())
  cpu       Float?
  memory    Float?
  latency   Float?
  status    ServiceStatus
  errorMsg  String?
  Service   Service       @relation(fields: [serviceId], references: [id])
  @@index([timestamp])
  @@map("metrics")
}

model AlertRule {
  id            Int        @id @default(autoincrement())
  serviceId     Int
  field         String
  condition     String
  severity      AlertLevel
  active        Boolean    @default(true)
  createdBy     Int
  createdAt     DateTime   @default(now())
  alerts        Alert[]
  createdByUser User       @relation("CreatedByUser", fields: [createdBy], references: [id])
  Service       Service    @relation("ServiceToAlertRules", fields: [serviceId], references: [id])
}

model Alert {
  id            Int            @id @default(autoincrement())
  serviceId     Int
  ruleId        Int
  triggeredAt   DateTime       @default(now())
  message       String
  resolved      Boolean        @default(false)
  userId        Int?
  AlertRule     AlertRule      @relation(fields: [ruleId], references: [id])
  Service       Service        @relation(fields: [serviceId], references: [id])
  User          User?          @relation(fields: [userId], references: [id])
  notifications Notification[]
}

model ServiceUserNotification {
  id        Int     @id @default(autoincrement())
  serviceId Int
  userId    Int

  Service   Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  User      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serviceId, userId])
}


model Notification {
  id      Int                 @id @default(autoincrement())
  userId  Int
  alertId Int?
  message String
  type    NotificationType
  channel NotificationChannel
  sentAt  DateTime            @default(now())
  Alert   Alert?              @relation(fields: [alertId], references: [id])
  User    User                @relation(fields: [userId], references: [id])
}

model SLA {
  id          Int       @id @default(autoincrement())
  serviceId   Int
  periodStart DateTime
  periodEnd   DateTime
  uptimePct   Float
  downtime    Int
  status      SLAStatus
  Service     Service   @relation(fields: [serviceId], references: [id])
}

model SystemLog {
  id        Int      @id @default(autoincrement())
  timestamp DateTime @default(now())
  type      LogType
  message   String
  serviceId Int?
  Service   Service? @relation(fields: [serviceId], references: [id])

  @@index([timestamp])
  @@index([serviceId, timestamp])
  @@map("system_logs")
}

model MonitoringConfig {
  id             Int              @id @default(autoincrement())
  serviceId      Int              @unique
  interval       Int
  timeout        Int
  webhookUrl     String?
  Service     Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  PingConfig     PingConfig?
  SnmpConfig     SnmpConfig?
}

model PingConfig {
  id           Int              @id @default(autoincrement())
  monitoringId Int              @unique
  ipAddress    String
  packetSize   Int?
  ttl          Int?
  Monitoring   MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

model SnmpConfig {
  id                     Int              @id @default(autoincrement())
  monitoringId           Int              @unique
  host                   String
  version                SnmpVersion
  community              String?
  username               String?
  authProtocol           String?
  authPassword           String?
  privProtocol           String?
  privPassword           String?
  oid                    String
  retries                Int?
  delay                  Int?
  alertAfterFailures     Int?
  minAlertInterval       Int?
  expectedResponseTimeMs Int?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  Monitoring   MonitoringConfig @relation(fields: [monitoringId], references: [id], onDelete: Cascade)
}

enum SnmpVersion {
  v1
  v2c
  v3
}

enum Role {
  ADMIN
  USER
  AGENT
}

enum Status {
  ACTIVE
  INACTIVE
}

enum TeamRole {
  OWNER
  EDITOR
  VIEWER
}

enum ServiceType {
  SERVER
  NETWORK
  WEBSITE
  API
  DATABASE
  CUSTOM
  SNMP
  PING
}

enum ServiceStatus {
  UP
  DOWN
  DEGRADED
  PENDING
}

enum AlertLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum NotificationType {
  EMAIL
  PUSH
  SMS
  SLACK
  TELEGRAM
}

enum NotificationChannel {
  EMAIL
  SLACK
  PUSH
  SMS
  TELEGRAM
  WEBHOOK
}

enum SLAStatus {
  OK
  VIOLATED
  UNKNOWN
}

enum LogType {
  INFO
  ERROR
  WARNING
  EVENT
}

enum MetricType {
  CPU
  MEMORY
  LATENCY
  STATUS
}

enum MonitoringMode {
  cron
  agent
  both
}
{
  "info": {
    "name": "InfraWatch - Métricas de Agentes",
    "description": "Coleção para visualizar métricas dos agentes instalados",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://infra42luanda.duckdns.org",
      "type": "string"
    },
    {
      "key": "access_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "agent_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    const response = pm.response.json();",
              "    if (response.access_token) {",
              "        pm.collectionVariables.set('access_token', response.access_token);",
              "        console.log('✅ Token salvo:', response.access_token.substring(0, 20) + '...');",
              "    }",
              "}",
              "",
              "pm.test('Login realizado', function () {",
              "    pm.response.to.have.status.oneOf([200, 201]);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"vicor32leonel@gmail.com\",\n  \"password\": \"SUA_SENHA_AQUI\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/auth/login",
          "host": ["{{base_url}}"],
          "path": ["auth", "login"]
        }
      }
    },
    {
      "name": "2. Listar Todos os Agentes",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.length > 0) {",
              "        const firstAgent = response.data[0];",
              "        pm.collectionVariables.set('agent_id', firstAgent.id);",
              "        console.log('✅ Primeiro agente ID salvo:', firstAgent.id);",
              "        console.log('📊 Agentes encontrados:', response.data.length);",
              "        ",
              "        // Mostrar resumo dos agentes",
              "        response.data.forEach((agent, index) => {",
              "            console.log(`🤖 Agente ${index + 1}: ${agent.hostname} (${agent.status}) - Last seen: ${agent.lastSeen || 'Never'}`);",
              "        });",
              "    }",
              "}",
              "",
              "pm.test('Agentes listados', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/agents",
          "host": ["{{base_url}}"],
          "path": ["agents"]
        }
      }
    },
    {
      "name": "3. Métricas da Última 1 Hora",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.metrics) {",
              "        console.log('📊 Métricas encontradas:', response.data.metrics.length);",
              "        ",
              "        if (response.data.metrics.length > 0) {",
              "            const latest = response.data.metrics[0];",
              "            console.log('🔥 Última métrica:');",
              "            console.log(`  CPU: ${latest.cpuUsage}%`);",
              "            console.log(`  RAM: ${latest.memoryUsagePercent}%`);",
              "            console.log(`  Processos: ${latest.processesTotal}`);",
              "            console.log(`  Timestamp: ${latest.timestamp}`);",
              "        }",
              "    }",
              "}",
              "",
              "pm.test('Métricas obtidas', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/agents/{{agent_id}}/metrics?hours=1",
          "host": ["{{base_url}}"],
          "path": ["agents", "{{agent_id}}", "metrics"],
          "query": [
            {
              "key": "hours",
              "value": "1",
              "description": "Métricas da última 1 hora"
            }
          ]
        }
      }
    },
    {
      "name": "4. Métricas das Últimas 24 Horas",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    if (response.data && response.data.metrics) {",
              "        console.log('📊 Total de métricas (24h):', response.data.metrics.length);",
              "        ",
              "        // Calcular estatísticas",
              "        if (response.data.metrics.length > 0) {",
              "            const cpuValues = response.data.metrics.map(m => m.cpuUsage);",
              "            const memValues = response.data.metrics.map(m => m.memoryUsagePercent);",
              "            ",
              "            const avgCpu = (cpuValues.reduce((a, b) => a + b, 0) / cpuValues.length).toFixed(1);",
              "            const maxCpu = Math.max(...cpuValues).toFixed(1);",
              "            const avgMem = (memValues.reduce((a, b) => a + b, 0) / memValues.length).toFixed(1);",
              "            const maxMem = Math.max(...memValues).toFixed(1);",
              "            ",
              "            console.log('📈 Estatísticas 24h:');",
              "            console.log(`  CPU - Média: ${avgCpu}%, Pico: ${maxCpu}%`);",
              "            console.log(`  RAM - Média: ${avgMem}%, Pico: ${maxMem}%`);",
              "        }",
              "    }",
              "}",
              "",
              "pm.test('Métricas 24h obtidas', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/agents/{{agent_id}}/metrics?hours=24",
          "host": ["{{base_url}}"],
          "path": ["agents", "{{agent_id}}", "metrics"],
          "query": [
            {
              "key": "hours",
              "value": "24",
              "description": "Métricas das últimas 24 horas"
            }
          ]
        }
      }
    },
    {
      "name": "5. Métricas Específicas por Agent ID",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/agents/SEU_AGENT_ID_AQUI/metrics?hours=6",
          "host": ["{{base_url}}"],
          "path": ["agents", "SEU_AGENT_ID_AQUI", "metrics"],
          "query": [
            {
              "key": "hours",
              "value": "6",
              "description": "Altere SEU_AGENT_ID_AQUI pelo ID real do agente"
            }
          ]
        }
      }
    },
    {
      "name": "6. Detalhes de um Agente Específico",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "if (pm.response.code === 200) {",
              "    const response = pm.response.json();",
              "    if (response.data) {",
              "        const agent = response.data;",
              "        console.log('🤖 Detalhes do Agente:');",
              "        console.log(`  ID: ${agent.id}`);",
              "        console.log(`  Hostname: ${agent.hostname}`);",
              "        console.log(`  IP: ${agent.ip}`);",
              "        console.log(`  OS: ${agent.os}`);",
              "        console.log(`  Status: ${agent.status}`);",
              "        console.log(`  Último ping: ${agent.lastSeen}`);",
              "        console.log(`  Criado em: ${agent.createdAt}`);",
              "    }",
              "}",
              "",
              "pm.test('Detalhes do agente obtidos', function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{access_token}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/agents/{{agent_id}}",
          "host": ["{{base_url}}"],
          "path": ["agents", "{{agent_id}}"]
        }
      }
    }
  ]
}
